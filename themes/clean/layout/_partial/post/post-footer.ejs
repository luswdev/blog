<% if (theme.sponsor && theme.sponsor.enable){ %>
    <% if(theme.sponsor.ko_fi){ %>
        <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1">
            <a href="https://ko-fi.com/<%- theme.sponsor.ko_fi %>" target="_blank" rel="noopener noreferrer">
                <img height="36" style="border:0px;height:36px;" src="https://cdn.ko-fi.com/cdn/kofi3.png?v=3" border="0" alt="Buy Me a Coffee at ko-fi.com" />
            </a>
        </div>
<% } %>

<% if (page.prev || page.next) { %>
    <div class="col-lg-8 offset-lg-2 col-md-10 offset-md-1">
        <ul class="pagination d-block text-center">
            <% if (page.prev){ %>
                <li class="previous page-item d-inline"><a href="<%- url_for(page.prev.path) %>" class="page-link float-left">&larr;  <%- __('next')%></a></li>
            <% } %>
            <% if (page.next){ %>
                <li class="next page-item d-inline"><a href="<%- url_for(page.next.path) %>" class="page-link float-right"><%- __('prev')%>  &rarr;</a></li>
            <% } %>
        </ul>
    </div>
<% } %>